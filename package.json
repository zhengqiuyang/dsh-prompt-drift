{
  "name": "dsh-prompt-drift",
  "version": "0.1.0",
  "description": "System-prompt surface drift gate for DeepSeek Harness: baselines every section contributed to the assembled system prompt and warns loudly when a plugin or preset upgrade silently adds, removes, or rewrites what the model is told",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test scripts",
    "coverage": "c8 --exclude \"test/**\" --check-coverage --lines 88 --branches 78 --functions 95 node test/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/run-tests.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "drift",
    "supply-chain",
    "security"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "c8": "^12.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-prompt-drift.git"
  }
}
